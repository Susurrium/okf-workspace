# Copy to .env and adjust only after completing the read-only preflight in README.md.
MARKITDOWN_IMAGE=obsidian-markitdown-service:1.3.0
MARKITDOWN_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12.13-slim-bookworm
MARKITDOWN_ENGINE_BUILD_ID=markitdown-0.1.6-py31213-assets-v3
MARKITDOWN_UID=10002
MARKITDOWN_GID=10002
MARKITDOWN_HOST_PORT=18010
MARKITDOWN_DATA_ROOT=/srv/markitdown-data
MARKITDOWN_TOKEN_FILE=/etc/obsidian-markitdown/api-tokens.txt
MARKITDOWN_EXPECTED_MOUNT=REPLACE_ME
MARKITDOWN_EXPECTED_SOURCE=REPLACE_ME
MARKITDOWN_TAILNET_FQDN=REPLACE_ME.ts.net
MARKITDOWN_BUNDLE_MANIFEST_SHA256=REPLACE_ME
MARKITDOWN_RELEASE_MANIFEST_SHA256=REPLACE_ME

# Conservative initial limits for a dedicated 2-vCPU, 4-GiB host.
MARKITDOWN_MAX_UPLOAD_BYTES=67108864
MARKITDOWN_MAX_RESULT_BYTES=134217728
MARKITDOWN_MAX_PAGES=500
MARKITDOWN_MAX_ACTIVE_TASKS=3
MARKITDOWN_MAX_CONCURRENT_UPLOADS=1
MARKITDOWN_MAX_SPOOL_BYTES=2147483648
MARKITDOWN_MIN_FREE_BYTES=2147483648
MARKITDOWN_CONVERSION_TIMEOUT_SECONDS=600
MARKITDOWN_SUCCESS_TTL_SECONDS=7200
MARKITDOWN_FAILURE_TTL_SECONDS=86400
MARKITDOWN_TOMBSTONE_TTL_SECONDS=86400
MARKITDOWN_ORPHAN_TTL_SECONDS=86400
MARKITDOWN_WORKER_POLL_SECONDS=1
MARKITDOWN_WORKER_STALE_SECONDS=15
MARKITDOWN_MAX_ATTEMPTS=2
