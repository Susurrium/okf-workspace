OKF_COUCHDB_URL=http://127.0.0.1:5984
OKF_COUCHDB_DATABASE=obsidian
OKF_COUCHDB_CREDENTIALS=/etc/okf-brain/couchdb-backup-credentials.json
OKF_COUCHDB_DUMP_DIR=/var/backups/okf-brain/couchdb
RESTIC_REPOSITORY=s3:s3.example.com/okf-brain/server
RESTIC_PASSWORD_FILE=/etc/okf-brain/restic-password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
